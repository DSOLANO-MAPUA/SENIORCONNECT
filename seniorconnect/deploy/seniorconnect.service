# sudo cp deploy/seniorconnect.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now seniorconnect
[Unit]
Description=SeniorConnect Flask API (gunicorn)
After=network.target mariadb.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/seniorconnect
EnvironmentFile=/etc/seniorconnect.env
ExecStart=/var/www/seniorconnect/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
